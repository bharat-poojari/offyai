{
  "name": "offyai",
  "version": "1.0.0",
  "description": "OffyAI - Complete AI Web UI with llama.cpp",
  "author": "OffyAi Team",
  "main": "main.js",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install",
    "lint": "cd frontend && npm run lint",
    "frontend:build": "cd frontend && npm run build",
    "electron:dev": "npm run frontend:build && electron .",
    "electron:prod": "electron .",
    "dev": "npm run electron:dev",
    "build:frontend": "npm run frontend:build",
    "build:electron": "npm run build:frontend && electron-builder",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:electron"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^8.3.2",
    "gpt-tokenizer": "^3.4.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "systeminformation": "^5.27.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.offyai.desktop",
    "productName": "OffyAI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "splash.html",
      "settings.json",
      "src/**/*",
      "frontend/out/**/*",
      "LICENSE.txt",
      "node_modules/**/*",
      "!**/.git/**",
      "!**/.gitignore",
      "!**/.env*",
      "!**/.DS_Store",
      "!**/*.md",
      "!**/*.log",
      "!**/*.map",
      "!**/*.jsonl",
      "!**/OFFYAI_TRAINING_CONTEXT.txt",
      "!**/package-lock.json",
      "!**/package.json.backup",
      "!**/dist-electron/**",
      "!**/frontend/public/**",
      "!**/frontend/.next/**",
      "!**/frontend/node_modules/**",
      "!**/models/**",
      "!**/llama/**",
      "!**/__pycache__/**",
      "!**/.idea/**",
      "!**/.vscode/**",
      "!**/node_modules/**/{README,README.md,readme,readme.md,CHANGELOG,LICENSE,LICENSE*,.bin,.cache,*.md}",
      "!**/node_modules/**/.bin",
      "!**/node_modules/**/*.d.ts"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/images/offyai.png",
      "files": [
        "package.json",
        "main.js",
        "preload.js",
        "splash.html",
        "settings.json",
        "src/**/*",
        "frontend/out/**/*",
        "LICENSE.txt",
        "node_modules/**/*",
        "!**/.git/**",
        "!**/.gitignore",
        "!**/.env*",
        "!**/.DS_Store",
        "!**/*.md",
        "!**/*.log",
        "!**/*.map",
        "!**/*.jsonl",
        "!**/OFFYAI_TRAINING_CONTEXT.txt",
        "!**/package-lock.json",
        "!**/package.json.backup",
        "!**/dist-electron/**",
        "!**/frontend/public/**",
        "!**/frontend/.next/**",
        "!**/frontend/node_modules/**",
        "!**/__pycache__/**",
        "!**/.idea/**",
        "!**/.vscode/**",
        "!**/node_modules/**/{README,README.md,readme,readme.md,CHANGELOG,LICENSE,LICENSE*,.bin,.cache,*.md}",
        "!**/node_modules/**/.bin",
        "!**/node_modules/**/*.d.ts"
      ],
      "extraResources": [
        {
          "from": "llama",
          "to": "llama",
          "filter": [
            "**/*.exe",
            "**/*.dll"
          ]
        },
        {
          "from": "models",
          "to": "models",
          "filter": [
            "**/*.gguf",
            "**/*.bin",
            "**/*.ggml"
          ]
        }
      ],
      "asarUnpack": [
        "llama/**/*",
        "*.dll",
        "*.exe",
        "*.node",
        "preload.js"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OffyAI",
      "license": "LICENSE.txt"
    },
    "mac": {
      "target": "dmg",
      "icon": "frontend/public/images/offyai.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "frontend/public/images/offyai.png",
      "category": "Utility"
    }
  }
}
